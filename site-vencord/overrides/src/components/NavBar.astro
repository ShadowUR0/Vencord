---
const navLinks = {
    download: ["التنزيل", "accentPurple"],
};

const page = Astro.url.pathname.split("/").filter(Boolean).at(-1);
---

<nav>
    <div class="nav-content">
        <div id="logo">
            <a href="/Vencord/" id="title">
                <img src="/Vencord/assets/vencord-arabic-logo.png" id="logo-img" alt="الصفحة الرئيسية لـ Vencord Arabic" />
            </a>
        </div>
        <div id="btns" class="p-label-m">
            <ul id="right">
                {
                    Object.entries(navLinks).map(([link, [display, color]]) => (
                        <li>
                            <a
                                href={`/Vencord/${link}`}
                                style={`--accent:var(--${color})`}
                                class:list={{ active: page === link }}
                            >
                                {display}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</nav>

<style>
    nav {
        background-color: var(--bg0);
        position: sticky;
        top: 0;
        z-index: 999;
    }

    .nav-content {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        margin: 0 var(--horizontal-margin);
    }

    h4 { margin: 0; }

    #btns {
        display: flex;
        flex-direction: row;
        align-items: center;
    }

    ul {
        list-style-type: none;
        overflow: hidden;
        padding: 0;
    }

    #btnsleft { flex: 1; }
    img { vertical-align: middle; }
    li { float: right; }

    a {
        text-decoration: none;
        text-align: center;
        padding: 0.5em;
        color: var(--fg0) !important;
        transition: 0.15s ease;
        transition-property: color, text-decoration;
    }

    .active { color: var(--accent) !important; }

    a:not(#title):where(:hover, :focus) {
        text-decoration: underline;
        text-decoration-thickness: 2px;
        outline: none;
        color: var(--accent);
    }

    #logo { position: relative; }
    #logo-img {
        height: 42px;
        width: auto;
        image-rendering: auto;
    }

    @media only screen and (max-width: 600px) {
        .nav-content {
            margin-top: 1em;
            position: relative;
            flex-direction: column;
        }
    }
</style>
