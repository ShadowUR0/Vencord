---
export const prerender = true;

import Layout from "@layouts/Layout.astro";
import LinkButton from "@components/LinkButton.astro";
import AutoSizeGrid from "@components/AutoSizeGrid.astro";

const features = [
    {
        icon: "light-bulb",
        title: "تثبيت سهل",
        description: "ثبته خلال دقائق باستخدام المثبت الرسومي",
    },
    {
        icon: "heart",
        title: "سهل الاستخدام",
        description: "الاضافات مرفقة مسبقا، فعّل ما تحتاجه فقط وابدأ الاستخدام",
    },
    {
        icon: "globe",
        title: "دعم ممتاز للمتصفح",
        description: "يمكنك استخدام Vencord Arabic مباشرة داخل متصفحك المدعوم",
    },
    {
        icon: "locked",
        title: "يحترم خصوصيتك",
        description: "يحجب تحليلات ديسكورد وتقارير الانهيار افتراضيا",
    },
    {
        icon: "package",
        title: "تحديثات مستمرة",
        description: "يبقى متوافقا مع تحديثات Vencord ويجري اصلاح المشاكل بسرعة",
    },
    {
        icon: "hammer-and-wrench",
        title: "مناسب للمطورين",
        description: "نظام اضافات مرن مع واجهات برمجية متعددة لمن يريد التوسعة والتخصيص",
    },
];
---

<Layout description="Vencord Arabic نسخة عربية من Vencord مع تعريب مدمج وتجربة استخدام موجهة للمستخدم العربي">
    <header>
        <section class="tagline">
            <img
                id="cute-logo"
                src="/Vencord/assets/vencord-arabic-logo.png"
                alt="شعار Vencord Arabic"
            />
            <h2>Vencord بتجربة عربية مدمجة</h2>
        </section>

        <section class="buttons">
            <AutoSizeGrid>
                <LinkButton href="/Vencord/download" class="main-btn">
                    تنزيل Vencord Arabic
                </LinkButton>
                <LinkButton href="https://github.com/ShadowUR0/Installer/releases/tag/latest">
                    اصدارات المثبت
                </LinkButton>
                <LinkButton href="https://github.com/ShadowUR0/Vencord">
                    عرض المشروع على GitHub
                </LinkButton>
            </AutoSizeGrid>
        </section>
    </header>

    <section class="features">
        {
            features.map(({ icon, title, description }) => (
                <div class="feature-card">
                    <div class="feature-icon" aria-hidden="true">
                        <img src={`/Vencord/assets/${icon}.png`} alt="" />
                    </div>
                    <h3 class="feature-title">{title}</h3>
                    <p class="feature-desc">{description}</p>
                </div>
            ))
        }
    </section>
</Layout>

<style>
    #cute-logo {
        width: 100%;
        max-width: 500px;
    }

    .tagline {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    section { margin-bottom: 2em; }
    .tagline { margin-bottom: 1em; }

    h1,
    h2 {
        line-height: 1 !important;
        margin: 0.5rem !important;
        text-align: center;
    }

    h1 { color: var(--accentPurple); }

    h2 {
        color: var(--grey1);
        font-size: 2.25em;
    }

    .buttons {
        display: flex;
        justify-content: center;
    }

    .main-btn {
        background-color: var(--accentPurple);
        color: var(--bgCurrentWord);
        outline: none;
    }

    .main-btn:focus-visible { outline: 2px solid var(--accentBlue); }
    .main-btn:hover { background-color: rgba(var(--accentPurpleRgb), 0.8); }
    .main-btn:active {
        background-color: rgba(var(--accentPurpleRgb), 0.9);
        outline: none;
    }

    .features {
        display: grid;
        gap: 1em;
        grid-template-columns: repeat(3, 1fr);
    }

    @media screen and (max-width: 1000px) {
        .features { grid-template-columns: repeat(2, 1fr); }
    }

    @media screen and (max-width: 600px) {
        .features { grid-template-columns: 1fr; }
    }

    .feature-card {
        background-color: var(--bg4);
        padding: 16px;
        border-radius: var(--border-lg);
        transition: 200ms box-shadow cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    .feature-icon {
        padding: 0.7em;
        width: 1.5em;
        height: 1.5em;
        background-color: var(--bgCurrentWord);
        border-radius: var(--border-md);
    }

    .feature-icon img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .feature-title {
        font-size: var(--fg1);
        line-height: 1rem;
    }

    .feature-desc {
        font-size: 0.9em;
        filter: brightness(90%);
        margin: 0;
    }

    svg {
        width: 1.5em;
        height: 1.5em;
    }
</style>
